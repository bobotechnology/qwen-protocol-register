{
  "name": "qwen-protocol-register",
  "version": "1.0.0",
  "description": "Pure-protocol Qwen account registration with dynamic Alibaba Cloud Captcha instrumentation and email activation",
  "main": "src/batch_register.js",
  "scripts": {
    "start": "node src/batch_register.js",
    "register": "node src/batch_register.js --guerrilla-mail --workers 4 --total 20",
    "register:proxy": "node src/batch_register.js --guerrilla-mail --workers 4 --total 20 --proxy socks5://127.0.0.1:10808"
  },
  "keywords": [
    "captcha",
    "reverse-engineering",
    "automation",
    "aliyun-captcha",
    "pure-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^7.26.0",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "crypto-js": "^4.2.0",
    "https-proxy-agent": "^7.0.0",
    "socks-proxy-agent": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
